# ==============================================================================
# Auth-as-a-Service (AaaS) - Environment Configuration Template
# ==============================================================================

# Application Runtime
APP_NAME=Auth-as-a-Service
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long

# Security Core & JWT Settings
JWT_SECRET_KEY=super-secret-jwt-signing-key-for-auth-as-a-service-token-engine-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_BCRYPT_ROUNDS=12
ENFORCE_PASSWORD_COMPLEXITY=true

# Database Settings (PostgreSQL in Production, SQLite fallback for Testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_service_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis Settings (Distributed Caching, Blacklist, Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_TIMEOUT_SECONDS=2
REDIS_KEY_PREFIX=aas:

# Rate Limiting Engine
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=100

# Brute Force Defense & Account Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Multi-Tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
MULTI_TENANCY_ENABLED=true

# Social OAuth2 Integrations
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback

# Email & Verification Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test-user
SMTP_PASSWORD=test-password
EMAIL_FROM=noreply@auth-service.io
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

